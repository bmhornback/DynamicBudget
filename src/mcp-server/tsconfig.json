{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    // Keep rootDir at the repo root so shared lib/types files compile alongside
    // src/mcp-server sources. The emitted entrypoint is therefore
    // ./dist/src/mcp-server/index.js.
    "rootDir": "../../",
    "paths": {
      "@/*": ["../../*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false
  },
  "include": [
    "../../lib/**/*.ts",
    "../../types/**/*.ts",
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../app/**",
    "../../components/**",
    "../../lib/__tests__/**",
    "../../lib/analytics.ts",
    "../../lib/storage.ts",
    "../../lib/useCountUp.ts",
    "**/__tests__/**",
    "./dist/**"
  ]
}
