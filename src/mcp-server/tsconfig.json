{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "../../dist/mcp-server",
    "rootDir": "../../",
    "paths": {
      "@/*": ["../../*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false
  },
  "include": [
    "../../lib/**/*.ts",
    "../../types/**/*.ts",
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../app/**",
    "../../components/**",
    "../../lib/__tests__/**",
    "**/__tests__/**"
  ]
}
