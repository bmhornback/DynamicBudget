{
  "name": "@dynamicbudget/mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing DynamicBudget calculation tools to AI assistants (Claude, ChatGPT, etc.)",
  "private": false,
  "main": "./dist/index.js",
  "bin": {
    "dynamicbudget-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node ../../dist/mcp-server/src/mcp-server/index.js",
    "dev": "ts-node --project tsconfig.json index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dynamicbudget",
    "budget",
    "mcp",
    "model-context-protocol",
    "finance",
    "ai"
  ]
}
